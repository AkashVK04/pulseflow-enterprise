# PulseFlow Enterprise Environment Configuration Example
# Copy this file to .env for local overrides

# Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/pulseflow_db
SPRING_DATASOURCE_USERNAME=pulseflow_user
SPRING_DATASOURCE_PASSWORD=pulseflow_password

# JWT Security
JWT_SECRET=your_jwt_secret_key_at_least_256_bits_long

# Gemini AI Integration
GEMINI_API_KEY=your_gemini_api_key

# Mail Server (Optional)
SPRING_MAIL_HOST=smtp.mailtrap.io
SPRING_MAIL_PORT=2525
SPRING_MAIL_USERNAME=user
SPRING_MAIL_PASSWORD=pass

# Server Port
PORT=8080

# Application Base URL
APP_URL=http://localhost:3000
